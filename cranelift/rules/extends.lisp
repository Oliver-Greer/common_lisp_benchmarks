  ((icmp ?ty ne (sextend ?cty ?x) (sextend ?cty ?y))
   :eval
   (let ((?ty0 (clif-type ?x)))
     (when ?ty0
       (let ((?ty2 (clif-type ?y)))
         (when (and ?ty2 (eql ?ty2 ?ty0)) (yield-rewrite (icmp ?ty ne ?x ?y)))))))

