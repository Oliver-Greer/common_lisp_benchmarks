  ;; ISLE: (rule (simplify (ishl (fits_in_64 ty) (select ty x (iconst ty y) (iconst ty z)) (iconst ty p)))
  ;; ISLE:     (select ty x (iconst ty (imm64_shl ty y p)) (iconst ty (imm64_shl ty z p))))
  ((ishl (?k0) (select (?ty2) ?x (iconst (?ty3) (?y)) (iconst (?ty4) (?z))) (iconst (?ty5) (?p)))
   :eval
   (let ((?x1 (match-fits-in-64 ?k0)))
     (when (and ?x1 (and (eql ?ty2 ?x1) (and (eql ?ty3 ?x1) (and (eql ?ty4 ?x1) (eql ?ty5 ?x1)))))
       (let* ((?v6 (imm64-shl ?x1 ?y ?p))
              (?v7 (imm64-shl ?x1 ?z ?p)))
         (yield-rewrite (select (?x1) ?x (iconst (?x1) (?v6)) (iconst (?x1) (?v7))))))))

  ;; ISLE: (rule (simplify (bor ty (sshr ty x y) (sshr ty z y))) (sshr ty (bor ty x z) y))
  ((bor ?ty (sshr ?ty ?x ?y) (sshr ?ty ?z ?y))
   (sshr ?ty (bor ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (bor ty (ushr ty x y) (ushr ty z y))) (ushr ty (bor ty x z) y))
  ((bor ?ty (ushr ?ty ?x ?y) (ushr ?ty ?z ?y))
   (ushr ?ty (bor ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (band ty (sshr ty x y) (sshr ty z y))) (sshr ty (band ty x z) y))
  ((band ?ty (sshr ?ty ?x ?y) (sshr ?ty ?z ?y))
   (sshr ?ty (band ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (band ty (ushr ty x y) (ushr ty z y))) (ushr ty (band ty x z) y))
  ((band ?ty (ushr ?ty ?x ?y) (ushr ?ty ?z ?y))
   (ushr ?ty (band ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (band ty (sshr ty x y) (ushr ty z y))) (ushr ty (band ty x z) y))
  ((band ?ty (sshr ?ty ?x ?y) (ushr ?ty ?z ?y))
   (ushr ?ty (band ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (band ty (ushr ty x y) (sshr ty z y))) (ushr ty (band ty x z) y))
  ((band ?ty (ushr ?ty ?x ?y) (sshr ?ty ?z ?y))
   (ushr ?ty (band ?ty ?x ?z) ?y))

  ;; ISLE: (rule (simplify (band ty (ishl ty (band ty x (iconst_u ty y)) z) (iconst_u ty y))) (if-let true
  ;; ISLE:     (u64_eq (u64_and y (u64_wrapping_add y 1)) 0)) (band ty (ishl ty x z) (iconst_u ty y)))
  ((band (?ty) (ishl (?ty0) (band (?ty1) ?x (iconst (?ty2) (?y))) ?z) (iconst (?ty3) (?y4)))
   :eval
   (when (and (eql ?ty0 ?ty) (and (eql ?ty1 ?ty) (and (eql ?ty2 ?ty) (and (eql ?ty3 ?ty) (and (eql ?y4 ?y) (u64-eq (u64-and ?y (u64-wrapping-add ?y 1)) 0))))))
     (block c0
       (let ((?x5 (match-ty-vec128 ?ty)))
         (when ?x5
           (progn
             (let ((?x6 (match-ty-int (lane-type ?x5))))
               (when (and ?x6 (u64-lt-eq ?y (ty-umax ?x6)))
                 (let ((?v7 (imm64 ?y)))
                   (yield-rewrite (band (?ty) (ishl (?ty) ?x ?z) (splat (?x5) (iconst (?x6) (?v7))))))))
             (return-from c0 nil))))
       (when (eq ?ty 'i128)
         (progn
           (when (u64-lt-eq ?y (ty-umax 'i64))
             (let ((?v8 (imm64 ?y)))
               (yield-rewrite (band (?ty) (ishl (?ty) ?x ?z) (uextend i128 (iconst i64 (?v8)))))))
           (return-from c0 nil)))
       (let ((?x9 (match-ty-int ?ty)))
         (when ?x9
           (let ((?x10 (match-fits-in-64 ?x9)))
             (when (and ?x10 (u64-lt-eq ?y (ty-umax ?x10)))
               (progn
                 (let ((?v11 (imm64 ?y)))
                   (yield-rewrite (band (?ty) (ishl (?ty) ?x ?z) (iconst (?x10) (?v11)))))
                 (return-from c0 nil))))))))))
