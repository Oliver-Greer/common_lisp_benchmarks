;;;; Tests for the Cranelift rule port.
;;;;
;;;; 1. Unit tests of the Lisp ports of Rust helpers (div-by-constant magic
;;;;    numbers are checked against the expected values in div_const.rs's tests).
;;;; 2. End-to-end rewrites with the eqsat backend.
;;;; 3. Soundness fuzzing: saturate random integer terms, then evaluate every
;;;;    e-node with a small CLIF interpreter and check each e-class agrees.

(in-package #:cranelift-opts)

(defvar *failures* 0)
(defvar *checks* 0)

(defmacro check (form &optional description)
  `(progn
     (incf *checks*)
     (unless (ignore-errors ,form)
       (incf *failures*)
       (format t "~&FAIL: ~a~%" ,(or description `',form)))))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun f32 (x) (ldb (byte 32 0) (float-features:single-float-bits (float x 1f0))))
  (defun f64 (x) (ldb (byte 64 0) (float-features:double-float-bits (float x 1d0)))))

