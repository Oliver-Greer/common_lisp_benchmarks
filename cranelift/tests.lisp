(defun test-helpers ()
  ;; Numerics follow Rust's checked/wrapping/panicking conventions.
  (check (= (u64-wrapping-add (1- (expt 2 64)) 2) 1))
  (check (null (u64-checked-add (1- (expt 2 64)) 1)))
  (check (null (i64-checked-rem (- (expt 2 63)) -1)))
  (check (= (i32-rem -7 2) -1))
  (check (= (i32-checked-div -7 2) -3))
  (check (null (u64-checked-shl 1 64)))
  (check (= (u64-shl (expt 2 63) 1) 0) "shl drops shifted-out bits")
  (check (handler-case (progn (u32-sub 1 2) nil) (error () t)) "u32_sub panics on overflow")
  (check (= (u64-trailing-zeros 0) 64))
  (check (= (u8-rotl #x81 1) #x03))
  (check (= (i8-rotr 1 1) -128))
  (check (= (match-u32-from-u64 7) 7))
  (check (null (match-u32-from-u64 (expt 2 32))))
  ;; Types
  (check (= (ty-bits 'i32x4) 128))
  (check (eq (lane-type 'f32x4) 'f32))
  (check (eq (ty-half-width 'i64x2) 'i32x2))
  (check (null (ty-half-width 'i8)))
  (check (= (ty-smin 'i8) #x80))
  (check (null (match-fits-in-64 'i128)))
  ;; Imm64 is the masked unsigned bit pattern.
  (check (= (imm64-add 'i8 #xff 1) 0))
  (check (= (imm64-sshr 'i8 #x80 1) #xc0))
  (check (= (imm64-sdiv 'i8 #xf9 2) #xfd) "-7 / 2 = -3 in i8")
  (check (null (imm64-sdiv 'i8 #x80 #xff)) "i8 MIN / -1 traps")
  (check (= (imm64-srem 'i8 #xf9 2) #xff) "-7 % 2 = -1 in i8")
  (check (= (imm64-rotr 'i16 1 1) #x8000))
  (check (= (imm64-clz 'i16 1) 15))
  (check (= (imm64-ctz 'i32 0) 32))
  (check (= (imm64-icmp 'i8 'slt #xff 0) 1))
  (check (= (imm64-icmp 'i8 'ult #xff 0) 0))
  (check (= (i64-sextend-imm64 'i16 #xffff) -1))
  (check (= (match-imm64-power-of-two 64) 6))
  (check (null (match-imm64-power-of-two (expt 2 63))))
  (check (= (u64-bswap32 #x11223344) #x44332211))
  ;; Floats: IEEE results, None for NaN, libm sign-of-zero conventions.
  (check (= (f32-add (f32 1) (f32 2)) (f32 3)))
  (check (= (f64-div (f64 1) (f64 0)) (f64 sb-ext:double-float-positive-infinity)))
  (check (null (f64-sub (f64 sb-ext:double-float-positive-infinity)
                        (f64 sb-ext:double-float-positive-infinity))))
  (check (null (f32-sqrt (f32 -1))))
  (check (= (f32-sqrt (f32 -0.0)) #x80000000))
  (check (= (f32-nearest (f32 2.5)) (f32 2)))
  (check (= (f32-nearest (f32 -0.5)) #x80000000))
  (check (= (f64-floor (f64 -0.5)) (f64 -1)))
  (check (= (f64-ceil (f64 -0.5)) (f64 -0.0)))
  (check (= (f32-trunc (f32 -1.5)) (f32 -1)))
  (check (= (f32-min (f32 0.0) (f32 -0.0)) #x80000000))
  (check (= (f32-max (f32 0.0) (f32 -0.0)) 0))
  (check (null (f64-max (f64 1) #x7ff8000000000000)))
  (check (= (f16-max #x3c00 #x4000) #x4000) "max(1.0, 2.0) in f16")
  (check (= (f16-min #xbc00 #x3c00) #xbc00) "min(-1.0, 1.0) in f16")
  (check (= (f128-neg 0) (ash 1 127)))
  (check (= (f32-from-uint (1+ (expt 2 24))) (f32 (expt 2 24))) "ties to even")
  (check (= (f32-from-uint (+ 3 (expt 2 24))) (f32 (+ 4 (expt 2 24)))))
  (check (= (f32-from-uint (1- (expt 2 64))) #x5f800000))
  (check (= (f64-from-sint -3) (f64 -3)))
  ;; Generated helpers
  (check (eq (intcc-comparable 'slt 'sge) t))
  (check (null (nth-value 1 (intcc-comparable 'slt 'ult))))
  (check (i64-is-any-sign-power-of-two -8))
  (check (not (i64-is-any-sign-power-of-two 6)))
  (check (= (splat8 #xab) (* #xab (/ (1- (expt 2 128)) 255))))
  ;; Division magic numbers against the Rust test vectors.
  (dolist (v +div-magic-vector-data+)
    (destructuring-bind (kind d &rest expected) v
      (let ((actual (rest (funcall (ecase kind
                                     (u32 #'div-const-magic-u32)
                                     (u64 #'div-const-magic-u64)
                                     (s32 #'div-const-magic-s32)
                                     (s64 #'div-const-magic-s64))
                                   d))))
        (check (equal actual expected)
               (format nil "magic ~a ~a: ~a /= ~a" kind d actual expected))))))

;;; 2. End-to-end rewrites (eqsat)

(defun rewrites-to-p (term expected &key (rules 'cranelift-opts) (max-iter 4))
  "Whether running RULES on TERM puts EXPECTED in TERM's e-class."
  (let* ((*egraph* (make-egraph :analyses '(clif-type)))
         (root (term-enode term)))
    (egraph-rebuild)
    (run-rewrites rules :max-iter max-iter)
    (let ((e (term-enode expected)))
      (egraph-rebuild)
      (eq (enode-find root) (enode-find e)))))

(defmacro check-rewrite (term expected &rest keys)
  `(check (rewrites-to-p ',term ',expected ,@keys)
          (format nil "~s => ~s" ',term ',expected)))

(defun test-rewrites ()
  ;; arithmetic.isle
  (check-rewrite (iadd i32 (param i32 x) (iconst i32 0)) (param i32 x))
  (check-rewrite (isub i64 (param i64 x) (param i64 x)) (iconst i64 0))
  (check-rewrite (imul i32 (param i32 x) (iconst i32 8)) (ishl i32 (param i32 x) (iconst i32 3)))
  (check-rewrite (imul i32 (param i32 x) (iconst i32 #xffffffff)) (ineg i32 (param i32 x)))
  (check-rewrite (iadd i32x4 (param i32x4 v) (vconst i32x4 0)) (param i32x4 v))
  ;; cprop.isle: wrapping constant folding at the type's width
  (check-rewrite (iadd i32 (iconst i32 3) (iconst i32 4)) (iconst i32 7))
  (check-rewrite (iadd i8 (iconst i8 255) (iconst i8 1)) (iconst i8 0))
  (check-rewrite (sdiv (iconst i8 #xf9) (iconst i8 2)) (iconst i8 #xfd))
  (check-rewrite (fadd f32 (f32const f32 #.(f32 1)) (f32const f32 #.(f32 2)))
                 (f32const f32 #.(f32 3)))
  ;; skeleton.isle / div_const: division by constants
  (check-rewrite (udiv (param i32 x) (iconst i32 8)) (ushr i32 (param i32 x) (iconst i32 3)))
  (check-rewrite (udiv (param i32 x) (iconst i32 7))
                 ;; magic_u32(7) = (#x24924925, do_add, 3)
                 (ushr i32
                       (iadd i32 (umulhi i32 (param i32 x) (iconst i32 #x24924925))
                             (ushr i32 (isub i32 (param i32 x)
                                             (umulhi i32 (param i32 x) (iconst i32 #x24924925)))
                                   (iconst i32 1)))
                       (iconst i32 2)))
  (check-rewrite (brif (iconst i32 0) then else) (jump else))
  (check-rewrite (brif (uextend i32 (param i8 c)) then else) (brif (param i8 c) then else))
  ;; icmp.isle, selects.isle
  (check-rewrite (icmp i8 eq (param i32 x) (param i32 x)) (iconst i8 1))
  (check-rewrite (select i32 (iconst i8 1) (param i32 a) (param i32 b)) (param i32 a))
  ;; extends.isle uses the CLIF-TYPE analysis for `value_type`
  (check-rewrite (ireduce i32 (uextend i64 (param i32 x))) (param i32 x))
  (check (not (rewrites-to-p '(ireduce i16 (uextend i64 (param i32 x))) '(param i32 x)))
         "ireduce to a different type is not the identity"))

;;; 3. Soundness fuzzing with a CLIF interpreter for scalar integers.
;;;
;;; Random integer terms are saturated with every rule, then each e-node is
;;; evaluated from its children's values under random parameter assignments.
;;; All e-nodes of an e-class must agree; a disagreement is an unsound rewrite.

(defun int-type-p (ty)
  (and (symbolp ty) (ignore-errors (ty-is-int ty)) (<= (ty-bits* ty) 64)))

(defun signed (v ty) (wrap-to v t (ty-bits* ty)))
(defun unsigned (v ty) (wrap-to v nil (ty-bits* ty)))

(defun eval-icmp (cc ty a b)
  (let ((sa (signed a ty)) (sb (signed b ty)))
    (ecase cc
      (eq (= a b)) (ne (/= a b))
      (ult (< a b)) (ule (<= a b)) (ugt (> a b)) (uge (>= a b))
      (slt (< sa sb)) (sle (<= sa sb)) (sgt (> sa sb)) (sge (>= sa sb)))))

(defun eval-op (op args env)
  "Value (TYPE . BITS) of CLIF operation OP on ARGS, or NIL when unknown or
undefined. ARGS are leaf atoms (types, immediates, condition codes) or typed
values."
  (let* ((ty (first args))
         (vals (mapcar (lambda (a) (if (consp a) (cdr a) a)) (rest args))))
    (flet ((v (i) (nth i vals))
           (arg-ty (i) (car (nth (1+ i) args)))
           (ret (bits) (and bits (cons ty (unsigned bits ty)))))
      (unless (or (member op '(udiv sdiv urem srem)) (int-type-p ty))
        (return-from eval-op nil))
      (let ((bits (when (int-type-p ty) (ty-bits* ty))))
        (case op
          (param (gethash (cons ty (v 0)) env))
          (iconst (ret (v 0)))
          (iadd (ret (+ (v 0) (v 1))))
          (isub (ret (- (v 0) (v 1))))
          (imul (ret (* (v 0) (v 1))))
          (ineg (ret (- (v 0))))
          (iabs (ret (abs (signed (v 0) ty))))
          (band (ret (logand (v 0) (v 1))))
          (bor (ret (logior (v 0) (v 1))))
          (bxor (ret (logxor (v 0) (v 1))))
          (bnot (ret (lognot (v 0))))
          (band_not (ret (logandc2 (v 0) (v 1))))
          (bor_not (ret (logorc2 (v 0) (v 1))))
          (bxor_not (ret (lognot (logxor (v 0) (v 1)))))
          (ishl (ret (ash (v 0) (mod (v 1) bits))))
          (ushr (ret (ash (v 0) (- (mod (v 1) bits)))))
          (sshr (ret (ash (signed (v 0) ty) (- (mod (v 1) bits)))))
          (rotl (let ((n (mod (v 1) bits)))
                  (ret (logior (ash (v 0) n) (ash (v 0) (- n bits))))))
          (rotr (let ((n (mod (- (v 1)) bits)))
                  (ret (logior (ash (v 0) n) (ash (v 0) (- n bits))))))
          (smin (ret (if (<= (signed (v 0) ty) (signed (v 1) ty)) (v 0) (v 1))))
          (smax (ret (if (>= (signed (v 0) ty) (signed (v 1) ty)) (v 0) (v 1))))
          (umin (ret (min (v 0) (v 1))))
          (umax (ret (max (v 0) (v 1))))
          (icmp (ret (if (eval-icmp (v 0) (arg-ty 1) (v 1) (v 2)) 1 0)))
          (select (ret (if (zerop (v 0)) (v 2) (v 1))))
          (bmask (ret (if (zerop (v 0)) 0 -1)))
          (uextend (ret (v 0)))
          (sextend (ret (signed (v 0) (arg-ty 0))))
          (ireduce (ret (v 0)))
          (popcnt (ret (logcount (v 0))))
          (clz (ret (- bits (integer-length (v 0)))))
          (ctz (ret (if (zerop (v 0)) bits (1- (integer-length (logand (v 0) (- (v 0))))))))
          (bswap (when (zerop (mod bits 16))
                   (ret (cranelift-opts::u64-bswap (v 0) (/ bits 8)))))
          (bitrev (ret (loop with r = 0 for i below bits
                             do (setf r (logior (ash r 1) (ldb (byte 1 i) (v 0))))
                             finally (return r))))
          (bitselect (ret (logior (logand (v 0) (v 1)) (logandc1 (v 0) (v 2)))))
          (umulhi (ret (ash (* (v 0) (v 1)) (- bits))))
          (smulhi (ret (ash (* (signed (v 0) ty) (signed (v 1) ty)) (- bits))))
          ;; Skeleton division: the type is the operands'; zero divisors and
          ;; signed overflow trap, so they have no value.
          ((udiv urem sdiv srem)
           (let* ((ty (car (first args)))
                  (a (cdr (first args))) (b (cdr (second args))))
             (when (and (int-type-p ty) (not (zerop b)))
               (let ((sa (signed a ty)) (sb (signed b ty)))
                 (unless (and (member op '(sdiv srem)) (= sb -1)
                              (= sa (- (expt 2 (1- (ty-bits* ty))))))
                   (cons ty (unsigned (ecase op
                                        (udiv (truncate a b)) (urem (rem a b))
                                        (sdiv (truncate sa sb)) (srem (rem sa sb)))
                                      ty))))))))))))

(defun enode-value (enode values env)
  (let ((args (loop for i below (enode-n-args enode)
                    collect (let ((child (enode-find (enode-arg i enode))))
                              (if (zerop (enode-n-args child))
                                  ;; A leaf class: its atom (leaves are never merged).
                                  (enode-fsym child)
                                  (or (gethash child values)
                                      (return-from enode-value nil)))))))
    (if (and (symbolp (enode-fsym enode)) (not (zerop (enode-n-args enode))))
        (ignore-errors (eval-op (enode-fsym enode) args env))
        nil)))

(defun check-egraph-sound (env)
  "List of (class-value enode-value enode) disagreements under ENV."
  (let ((values (make-hash-table :test 'eq))
        (classes (ggs/eqsat::egraph-class-list *egraph*))
        (bad '()))
    (loop for changed = nil
          do (dolist (c classes)
               (let ((c (enode-find c)))
                 (unless (gethash c values)
                   (dolist (n (list-enodes c))
                     (let ((v (enode-value n values env)))
                       (when v
                         (setf (gethash c values) v changed t)
                         (return)))))))
          while changed)
    (dolist (c classes bad)
      (let* ((c (enode-find c)) (cv (gethash c values)))
        (when cv
          (dolist (n (list-enodes c))
            (let ((v (enode-value n values env)))
              (when (and v (not (equal v cv)))
                (push (list cv v n) bad)))))))))

(defparameter +fuzz-types+ '(i8 i16 i32 i64))
(defparameter +fuzz-ops+
  '((iadd 2) (isub 2) (imul 2) (ineg 1) (iabs 1) (band 2) (bor 2) (bxor 2) (bnot 1)
    (ishl 2) (ushr 2) (sshr 2) (rotl 2) (rotr 2) (smin 2) (smax 2) (umin 2) (umax 2)
    (popcnt 1) (clz 1) (ctz 1) (bswap 1) (bitrev 1) (bitselect 3) (umulhi 2) (smulhi 2)
    (bmask 1) (icmp 2) (select 3) (uextend 1) (sextend 1) (ireduce 1)
    (udiv 2) (sdiv 2) (urem 2) (srem 2)))

(defun random-const (ty)
  (let ((bits (ty-bits* ty)))
    (unsigned (case (random 8)
                (0 0) (1 1) (2 -1) (3 (ash 1 (random bits))) (4 (1- (ash 1 (1- bits))))
                (5 (- (ash 1 (1- bits)))) (6 (random 17))
                (t (random (ash 1 bits))))
              ty)))

(defun random-term (ty depth)
  (if (or (zerop depth) (< (random 1.0) 0.25))
      (if (< (random 1.0) 0.5)
          `(param ,ty ,(nth (random 3) '(x y z)))
          `(iconst ,ty ,(random-const ty)))
      (destructuring-bind (op arity) (nth (random (length +fuzz-ops+)) +fuzz-ops+)
        (let ((sub (lambda () (random-term ty (1- depth)))))
          (case op
            (icmp (let ((oty (nth (random 4) +fuzz-types+)))
                    (random-term-icmp ty oty depth)))
            (select `(select ,ty ,(random-term ty (1- depth)) ,(funcall sub) ,(funcall sub)))
            ((uextend sextend)
             (let ((narrow (remove-if-not (lambda (n) (< (ty-bits* n) (ty-bits* ty))) +fuzz-types+)))
               (if narrow
                   `(,op ,ty ,(random-term (nth (random (length narrow)) narrow) (1- depth)))
                   (funcall sub))))
            (ireduce
             (let ((wide (remove-if-not (lambda (w) (> (ty-bits* w) (ty-bits* ty))) +fuzz-types+)))
               (if wide
                   `(ireduce ,ty ,(random-term (nth (random (length wide)) wide) (1- depth)))
                   (funcall sub))))
            ((udiv sdiv urem srem) `(,op ,(funcall sub) ,(funcall sub)))
            (t `(,op ,ty ,@(loop repeat arity collect (funcall sub)))))))))

(defun random-term-icmp (ty oty depth)
  (if (eq ty 'i8)
      `(icmp i8 ,(nth (random 10) '(eq ne slt sle sgt sge ult ule ugt uge))
             ,(random-term oty (1- depth)) ,(random-term oty (1- depth)))
      `(uextend ,ty ,(random-term-icmp 'i8 oty depth))))

(defun random-env ()
  (let ((env (make-hash-table :test 'equal)))
    (dolist (ty +fuzz-types+)
      (dolist (name '(x y z))
        ;; One value per name and type: (param i32 x) and (param i8 x) differ.
        (setf (gethash (cons ty name) env) (cons ty (random-const ty)))))
    env))

(defun fuzz (&key (n 200) (depth 4) (envs 8) (max-iter 3) (seed 42) verbose)
  "Saturate N random terms and check soundness. Returns the failure count."
  (let ((*random-state* (sb-ext:seed-random-state seed))
        (failures 0))
    (dotimes (i n failures)
      (let* ((ty (nth (random 4) +fuzz-types+))
             (term (random-term ty depth))
             (*egraph* (make-egraph :analyses '(clif-type))))
        (handler-case
            (progn
              (term-enode term)
              (egraph-rebuild)
              (run-rewrites 'cranelift-opts :max-iter max-iter :initial-match-limit 2000)
              (dotimes (k envs)
                (let* ((env (random-env))
                       (bad (check-egraph-sound env)))
                  (when bad
                    (incf failures)
                    (format t "~&UNSOUND: ~s~%  e.g. class ~s vs node ~s = ~s~%"
                            term (first (first bad)) (ggs/eqsat::enode-fsym (third (first bad)))
                            (second (first bad)))
                    (return)))))
          (error (e)
            (incf failures)
            (format t "~&ERROR on ~s:~%  ~a~%" term e)))
        (when (and verbose (zerop (mod (1+ i) 50)))
          (format t "~&~d terms~%" (1+ i)))))))

(defun run-tests (&key (fuzz 200))
  (let ((*failures* 0) (*checks* 0))
    (test-helpers)
    (test-rewrites)
    (format t "~&~d/~d checks passed~%" (- *checks* *failures*) *checks*)
    (let ((f (fuzz :n fuzz)))
      (format t "~&fuzz: ~d/~d random terms sound~%" (- fuzz f) fuzz)
      (and (zerop *failures*) (zerop f)))))
